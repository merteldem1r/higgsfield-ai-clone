NEXT_PUBLIC_SUPABASE_URL=<your-supabase-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

FAL_KEY=<your-fal-ai-key>

# Server-only. Salt for hashing caller IPs before they're stored; generate with `openssl rand -hex 32`.
IP_HASH_SALT=<random-hex>
# Server-only. Images per IP (IPv6: per /64) per UTC day, counted across all users. Defaults to 30.
IP_DAILY_LIMIT=30
